# Phase 0 runs without service credentials. Blank means not connected.
# Copy to .env.local for local development only; never commit real values.
APP_BASE_URL=http://localhost:3000

# Phase 2: isolated Supabase project. Only these two values may reach browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: verified sender/domain and authorized test recipients required.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# No DMD credentials: integration deferred.
