# The disabled preview runs without service credentials.
# Copy to .env.local for local development only; never commit real values.
APP_BASE_URL=http://localhost:3000

# Phase 1 inquiries / Phase 2 accounts: isolated Supabase project. Only these two values may reach browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1 staff inquiry notification: verified sender and approved inbox required.
# Phase 4 adds customer event emails and delivery webhooks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# No DMD credentials: integration deferred.

# Phase 1 inquiry gate: keep false until private DB, sender/inbox and policy are verified.
LEAD_CAPTURE_ENABLED=false
LEAD_PRIVACY_APPROVED=false
LEAD_PRIVACY_VERSION=
LEAD_NOTIFICATION_EMAIL=
# Generate an independent random server-only secret of at least 32 characters.
LEAD_RATE_LIMIT_SECRET=

# Identity gate: enable only after hosted migration, policy and Auth settings verification.
AUTH_ENABLED=false
ACCOUNT_POLICIES_APPROVED=false
ACCOUNT_POLICY_VERSION=

# Phase 3: requires private document migration and server-only service key.
# Uploads enter quarantine; this flag does NOT enable scanning or file release.
DOCUMENT_UPLOADS_ENABLED=false
